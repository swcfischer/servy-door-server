# Example environment variables for server
# Copy this to `.env` and fill with real secrets (do NOT commit `.env`).

# Google OAuth Credentials (get from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Session secret for express-session
SESSION_SECRET=your-session-secret

# Server URL (production)
SERVER_URL=https://servy-door-server.onrender.com

# JWT secret
secret=your-jwt-secret

# Node environment (development, production)
NODE_ENV=development

# Server port
PORT=8888

# Database - Leave DATABASE_URL unset for local SQLite development
# SQLite will automatically use: db/database.sqlite
# In production on Render, set DATABASE_URL to your PostgreSQL connection string

# Set to true to enable app-side feature flag for Claude Sonnet (does not provision the service)
ENABLE_CLAUDE_SONNET=false

# API Keys (optional)
# OPENAI_API_KEY=your-openai-api-key
# GEMINI_API_KEY=your-gemini-api-key
# YOUTUBE_API_KEY=your-youtube-api-key


